{
  "name": "ruler-reports",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted marketing reporting platform for agencies: multichannel reports, live dashboards, automations, goals, timeline, AI insights, public API v2, webhooks and MCP.",
  "scripts": {
    "dev": "next dev -p 3104",
    "build": "node scripts/build.mjs",
    "start": "next start -p 3104",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "mcp": "tsx mcp/server.ts",
    "tick": "tsx scripts/tick.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "build:prod": "next build",
    "start:prod": "node scripts/start-prod.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:review": "node scripts/i18n-review.mjs"
  },
  "dependencies": {
    "@bible-strong/avatar-core": "^0.1.0",
    "@bible-strong/avatar-react": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "motion": "^14.5.0",
    "next": "^15.5.9",
    "nodemailer": "^6.9.16",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.3",
    "simple-icons": "^15.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "postcss": "^8.4.49",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
