# SQLite locally. A postgres:// URL (Vercel + Neon) makes `npm run build` use Postgres: see docs/DEPLOY-VERCEL.md
# (Neon also sets DATABASE_URL_UNPOOLED, used for schema changes). SEED_DEMO=1 loads the demo data into an empty Postgres.
DATABASE_URL="file:./dev.db"
# Uploaded images: disk (default) or db (default on Vercel, whose functions have no lasting disk)
# MEDIA_STORE="disk"
# 32+ random chars. Signs sessions and encrypts integration credentials.
APP_SECRET="change-me-to-a-long-random-string-please"
APP_URL="http://localhost:3100"

# Optional: AI insights / assistant / Studio (falls back to a rule-based analyst without it)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Optional: email delivery for automations (otherwise mails land in the in-app Outbox)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="reports@your-agency.com"

# One sign-in for Google and Meta (docs/CONNECT-SETUP.md). Without them, accounts are connected by pasting tokens.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google Ads joins the Google sign-in once this is set (API Center of the agency's manager account)
GOOGLE_ADS_DEVELOPER_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""
# Facebook Login for Business: the configuration that holds the permissions (optional)
META_LOGIN_CONFIG_ID=""
# API versions (defaults checked 2026-11-02)
# GOOGLE_ADS_API_VERSION="v26"
# META_API_VERSION="v26.0"

# PDF export (server-side Chromium through Playwright): auto = on when Chromium is installed, off = hide the feature
PDF_ENABLED="auto"
# Where the PDF renderer opens the public page (an address reachable from inside the container); defaults to APP_URL
# PDF_BASE_URL="http://127.0.0.1:3100"

# Cron: set to "0" to disable the in-process scheduler (use `npm run tick` from OS cron instead)
ENABLE_SCHEDULER="1"
CRON_SECRET="change-me"
